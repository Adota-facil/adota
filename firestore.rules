rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function proprio(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function anunciante() {
      return autenticado()
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo in ['anunciante', 'ambos'];
    }

    match /usuarios/{usuarioId} {
      allow read, create, update, delete: if proprio(usuarioId);
    }

    match /animais/{animalId} {
      allow read: if true;
      allow create: if anunciante()
          && request.resource.data.anuncianteId == request.auth.uid;
      allow update, delete: if autenticado()
          && resource.data.anuncianteId == request.auth.uid
          && request.resource.data.anuncianteId == resource.data.anuncianteId;
    }

    match /solicitacoesAdocao/{solicitacaoId} {
      allow create: if autenticado()
          && request.resource.data.adotanteId == request.auth.uid;
      allow read: if autenticado()
          && (resource.data.adotanteId == request.auth.uid
              || resource.data.anuncianteId == request.auth.uid);
      allow update: if autenticado()
          && resource.data.anuncianteId == request.auth.uid;
      allow delete: if autenticado()
          && resource.data.adotanteId == request.auth.uid;
    }
  }
}
