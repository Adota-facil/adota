rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /pets/{petId}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /usuarios/{usuarioId}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == usuarioId;
    }
  }
}
